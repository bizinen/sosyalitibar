    "zod": "^4.1.5"
  },
  "devDependencies": {
    "@types/node": "^24.3.0",
    "@types/react": "^19.1.10",
    "@types/react-dom": "^19.1.7",
    "drizzle-kit": "^0.31.4",
    "eslint": "^9.36.0",
    "eslint-config-next": "16.3.8",
    "typescript": "^5.9.2",
    "vitest": "5.0.5"
  },
  "overrides": {
    "@esbuild-kit/core-utils@3.3.2": {
      "esbuild": "0.25.12"
    }
