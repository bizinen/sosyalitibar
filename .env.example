# Runtime
NODE_ENV=development
APP_URL=http://localhost:3000
APP_INTERNAL_URL=http://localhost:3000

# Admin authentication
ADMIN_USERNAME=admin
# Development only fallback. Production'da kullanmayın; ADMIN_PASSWORD_HASH zorunlu.
ADMIN_PASSWORD=change-this-development-only
# npm run auth:hash -- 'uzun-ve-guclu-sifre'
ADMIN_PASSWORD_HASH=
SESSION_SECRET=
CRON_SECRET=
AUDIT_HASH_SECRET=

# PostgreSQL
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/sosyal_itibar

# Meta / Facebook Login + Instagram API with Facebook Login
META_APP_ID=
META_APP_SECRET=
# Meta Developer Dashboard'da kullandığınız aktif Graph sürümü. Örn: v26.0
META_GRAPH_VERSION=
META_REDIRECT_URI=http://localhost:3000/api/meta/callback
META_WEBHOOK_VERIFY_TOKEN=
META_SCOPES=pages_show_list,pages_read_engagement,pages_read_user_content,instagram_basic,instagram_manage_comments

# Token encryption — openssl rand -base64 32
TOKEN_ENCRYPTION_KEY=
# Anahtar rotasyonunda bir önceki anahtarı geçici olarak burada tutun.
TOKEN_ENCRYPTION_KEY_PREVIOUS=

# OpenAI-compatible LLM (OpenRouter dahil)
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_MODEL=
LLM_FALLBACK_BASE_URL=
LLM_FALLBACK_API_KEY=
LLM_FALLBACK_MODEL=
LLM_TIMEOUT_MS=30000
LLM_MAX_RETRIES=2

# Reconciliation limits
SYNC_LOOKBACK_DAYS=30
SYNC_MAX_POSTS_PER_CONNECTION=100
SYNC_MAX_COMMENTS_PER_PARENT=1000
SYNC_CONNECTION_BATCH_SIZE=6
SYNC_CONCURRENCY=2
SYNC_LEASE_MS=1800000
WEBHOOK_BATCH_SIZE=25
WEBHOOK_CONCURRENCY=8
ANALYSIS_BATCH_SIZE=8
ANALYSIS_CONCURRENCY=4
ALERT_BATCH_SIZE=20
ALERT_CONCURRENCY=8
HEALTH_CHECK_CONCURRENCY=4

# Critical alert delivery — optional. n8n/Telegram/email bridge gibi bir HTTPS endpoint olabilir.
ALERT_WEBHOOK_URL=
ALERT_WEBHOOK_SECRET=
ALERT_SEVERITY_THRESHOLD=75
ALERT_ON_THREAT=true

# Worker
WORKER_POLL_MS=5000
RECONCILE_INTERVAL_MS=900000
HEALTH_CHECK_INTERVAL_MS=21600000
MAINTENANCE_INTERVAL_MS=86400000

# Data retention
RETENTION_WEBHOOK_DAYS=30
RETENTION_AUDIT_DAYS=365
RETENTION_RAW_ITEM_DAYS=90
RETENTION_ALERT_DAYS=180
